# ============================================================================
# bp-perkwatch 环境配置示例
# 复制为 .env 后填写。.env 已被 .gitignore 排除，不会进版本库。
# 本文件不包含任何真实密钥。
# ============================================================================

# ---------------------------------------------------------------------------
# DeepSeek —— AI 福利识别
# ---------------------------------------------------------------------------
# 控制台获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenAI 兼容端点。deepseek-flash 最便宜且支持 JSON Output；
# 需要更强推理时可换成 deepseek-v4-pro。
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_OUTPUT_TOKENS=4000

# 定时器每晚最多送多少篇文章给模型（0 = 不限，队列再长也一次吃完）。
# 积压几百篇时，这个上限就是单晚账单的上限。手动 `bp analyse` 不受它约束。
ANALYSE_BATCH_LIMIT=80

# 模型批量分析必须在低谷时段跑（DeepSeek 高峰价是低谷价的 2 倍）。
# 高峰 = 北京时间 周一~周五 09:00-12:00、14:00-18:00；周末与法定节假日全天低谷。
# 过了 LLM_BATCH_DEADLINE_HOUR_BJ 就停止调用模型，未分析的文章留到当晚继续。
LLM_BATCH_DEADLINE_HOUR_BJ=8

# true 时忽略上面的低谷限制、任何时间都分析（多花一倍钱，实时性更好）。
FORCE_ANALYSIS_ANYTIME=false

# ---------------------------------------------------------------------------
# Gmail —— 日报投递（正文 HTML + .md 附件）
# ---------------------------------------------------------------------------
# 前提：Google 账号已开启两步验证，并在
# https://myaccount.google.com/apppasswords 生成 16 位"应用专用密码"。
# 普通账号密码无法通过 SMTP 登录。
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
# 换成你自己的 Gmail 地址（必须和应用专用密码所属账号一致）
SMTP_USERNAME=your.name@gmail.com
SMTP_PASSWORD=
SMTP_FROM=your.name@gmail.com

# 收件人，多个用逗号分隔（默认发给自己）
REPORT_TO=your.name@gmail.com

# ---------------------------------------------------------------------------
# 调度时刻（北京时间）
# ---------------------------------------------------------------------------
# 18:05 起跑：正好避开 14:00-18:00 高峰，之后到次日 09:00 全程半价。
PIPELINE_START_HOUR_BJ=18
PIPELINE_START_MINUTE_BJ=5
# 10:00 发日报。日报只读数据库渲染模板，不调用模型，所以落在高峰时段也是零成本。
REPORT_SEND_HOUR_BJ=10

# ---------------------------------------------------------------------------
# 福利判定
# ---------------------------------------------------------------------------
VERIFICATION_MAX_AGE_DAYS=7
EXPIRING_SOON_DAYS=7
# true  = 日报每天重复列出"已确认且仍有效"的完整清单（摘要式）
# false = 每条福利只在状态变化时出现一次（严格不重复通知）
REPORT_REPEAT_LIVE_LIST=true

# ---------------------------------------------------------------------------
# 采集
# ---------------------------------------------------------------------------
MAX_ITEMS_PER_SOURCE=40
FETCH_DELAY_SECONDS=1.5
HTTP_TIMEOUT_SECONDS=25
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 bp-perkwatch/0.1

# 可选：你自己的 SearXNG 地址。留空则关键词发现走 DuckDuckGo HTML 端点。
SEARXNG_BASE_URL=
# 逗号分隔，搜索结果里排除的域名（营销号、灰产站点等）
SEARCH_DENY_DOMAINS=

# ---------------------------------------------------------------------------
# 路径（相对项目根即可）
# ---------------------------------------------------------------------------
DB_PATH=data/bp.db
REPORTS_DIR=reports
